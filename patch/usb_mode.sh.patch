+mtp_trace_init() {
+    [ "$LOG" != /dev/null ] || return 0
+    awk '$3=="debugfs"{f=1} END{exit f?0:1}' /proc/mounts 2>/dev/null || mount -t debugfs none /sys/kernel/debug 2>/dev/null
