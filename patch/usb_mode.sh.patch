+    mf=$(awk '/^MemFree/{f=$2} /^SwapFree/{s=$2} END{print f"/"s}' /proc/meminfo 2>/dev/null)
+    log "TRACE t=${1}s up=$up udc=$udc_state rss=${rss}kB free/swap=${mf}kB threads:$th fds:$fds"
+    mtp_trace_kmsg
+}
